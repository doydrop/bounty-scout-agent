# SERV Reasoning (either name works; OPENSERV_API_KEY wins if both are set)
OPENSERV_API_KEY=
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini
SERV_REASONING_EFFORT=low

# Kite Passport
KPASS_BIN=kpass
# Directory that holds .kite-passport/ for session create and session execute.
# Default is the repo root. If you approved the session from another folder, set this to that folder.
KPASS_CWD=
KITE_PASSPORT_BASE_URL=https://passport.prod.gokite.ai
KITE_SESSION_ID=
KITE_MAX_AMOUNT_PER_TX=0.05
KITE_MAX_TOTAL_AMOUNT=0.25
KITE_SESSION_TTL=1h
KITE_ASSETS=USDC
KITE_PAYER=kpass
# kpass | http (http is experimental — Passport has no public buyer HTTP API yet)
# KITE_AGENT_TOKEN is only read when KITE_PAYER=http. Never commit it.
KITE_AGENT_TOKEN=

# Agent402
AGENT402_BASE_URL=https://agent402.tools

# Scout
# auto (default): live only when a SERV key is set AND kpass is on PATH; otherwise dry-run.
# dry-run: fixtures only. live: require key + kpass (or KITE_PAYER=http + KITE_AGENT_TOKEN).
SCOUT_MODE=dry-run
SCOUT_BUDGET_USD=0.25
SCOUT_SLACK_USD=0.01
SCOUT_CHAINS=solana
SCOUT_ENTRY_COST=free_or_gas
SCOUT_CATEGORIES=contest,creative,defi,gigs
SCOUT_MAX_EFFORT_MIN=30
SCOUT_MAX_SEARCHES=8
SCOUT_MAX_EXTRACTS=8
SCOUT_MAX_META=8
SCOUT_MAX_RENDERS=1
SCOUT_ALLOW_ANSWER=false
SCOUT_HOST_ALLOWLIST=
SCOUT_RUN_TIMEOUT_MS=480000
SCOUT_DRY_RUN_DELAY_MS=0
PORT=8787
HOST=127.0.0.1
